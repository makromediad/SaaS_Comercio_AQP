# ── Supabase (modo nube) ──────────────────────────────────────────
# Copia este archivo a .env.local para desarrollo local.
# En producción, configura estas variables como SECRETS del repositorio:
#   Settings → Secrets and variables → Actions → New repository secret
# (el workflow de GitHub Actions las inyecta al ejecutar `vite build`).
#
# Si NO se definen, la app funciona en modo demo con localStorage.
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi...token-anon-del-proyecto"

# ── URL pública de la app (para enlaces de catálogo/WhatsApp) ─────
# En GitHub Pages project sites incluye la subruta del repo.
VITE_APP_URL="https://makromediad.github.io/SaaS_Comercio_AQP/"
